---
import Header from '../components/Header.astro';
import { DEFAULT_LOCALE, type SupportedLocale } from '../i18n/ui';
import { getLangFromUrl, useTranslations, getLocalizedPath, getHrefLangUrls } from '../i18n/utils';
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
  lang?: SupportedLocale;
}

const { lang: propLang, title: customTitle, description: customDescription } = Astro.props;
const lang = propLang || getLangFromUrl(Astro.url);
const t = useTranslations(lang);

const title = customTitle || t.seo.title;
const description = customDescription || t.seo.description;
const ogTitle = t.seo.ogTitle;
const ogDescription = t.seo.ogDescription;
const keywords = t.seo.keywords;

const siteUrl = (Astro.site ? Astro.site.toString() : 'https://makepng.github.io').replace(/\/$/, '');
const canonicalPath = getLocalizedPath(Astro.url.pathname, lang);
const canonicalURL = new URL(canonicalPath, siteUrl);
const hrefLangs = getHrefLangUrls(Astro.url.pathname, siteUrl);

const ogLocaleMap: Record<SupportedLocale, string> = {
  en: 'en_US',
  es: 'es_ES',
  pt: 'pt_BR',
  de: 'de_DE',
  fr: 'fr_FR',
  ja: 'ja_JP',
};
const ogLocale = ogLocaleMap[lang] || 'en_US';

const ogImage =
  'https://res.cloudinary.com/dpx6w78bt/image/upload/f_auto/q_auto/v1786342039/Online_Tool_rc1ybr.png';

// Structured data graph
const structuredData = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'WebApplication',
      '@id': `${siteUrl}/#webapp`,
      name: `MakePNG - ${t.workspace.heroTitle1} ${t.workspace.heroTitle2}`,
      url: canonicalURL.toString(),
      image: ogImage,
      description: description,
      applicationCategory: ['DesignApplication', 'MultimediaApplication', 'Photography'],
      operatingSystem: 'Any (Web Browser with WebAssembly support)',
      browserRequirements: 'Requires JavaScript and WebAssembly enabled',
      inLanguage: lang,
      offers: {
        '@type': 'Offer',
        price: '0',
        priceCurrency: 'USD',
        availability: 'https://schema.org/InStock',
      },
      featureList: [
        'AI-powered background removal',
        '100% client-side processing',
        'No server uploads required',
        'Free with no watermarks',
        'Supports JPG, PNG, and WebP',
        'Full resolution PNG export',
      ],
    },
    {
      '@type': 'HowTo',
      '@id': `${siteUrl}/#howto`,
      name: t.howItWorks.title,
      description: t.howItWorks.subtitle,
      totalTime: 'PT10S',
      inLanguage: lang,
      step: [
        {
          '@type': 'HowToStep',
          position: 1,
          name: t.howItWorks.step1Title,
          text: t.howItWorks.step1Desc,
        },
        {
          '@type': 'HowToStep',
          position: 2,
          name: t.howItWorks.step2Title,
          text: t.howItWorks.step2Desc,
        },
        {
          '@type': 'HowToStep',
          position: 3,
          name: t.howItWorks.step3Title,
          text: t.howItWorks.step3Desc,
        },
        {
          '@type': 'HowToStep',
          position: 4,
          name: t.howItWorks.step4Title,
          text: t.howItWorks.step4Desc,
        },
      ],
    },
    {
      '@type': 'FAQPage',
      '@id': `${siteUrl}/#faq`,
      inLanguage: lang,
      mainEntity: [
        {
          '@type': 'Question',
          name: t.faq.q1,
          acceptedAnswer: {
            '@type': 'Answer',
            text: t.faq.a1,
          },
        },
        {
          '@type': 'Question',
          name: t.faq.q2,
          acceptedAnswer: {
            '@type': 'Answer',
            text: t.faq.a2,
          },
        },
        {
          '@type': 'Question',
          name: t.faq.q3,
          acceptedAnswer: {
            '@type': 'Answer',
            text: t.faq.a3,
          },
        },
        {
          '@type': 'Question',
          name: t.faq.q4,
          acceptedAnswer: {
            '@type': 'Answer',
            text: t.faq.a4,
          },
        },
      ],
    },
    {
      '@type': 'BreadcrumbList',
      '@id': `${siteUrl}/#breadcrumbs`,
      itemListElement: [
        {
          '@type': 'ListItem',
          position: 1,
          name: 'Home',
          item: canonicalURL.toString(),
        },
      ],
    },
    {
      '@type': 'Organization',
      '@id': `${siteUrl}/#organization`,
      name: 'Make PNG',
      url: siteUrl,
      logo: `${siteUrl}/favicon.svg`,
    },
  ],
};
---

<!doctype html>
<html lang={lang} class="scroll-smooth">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover" />
    <meta name="generator" content={Astro.generator} />
    <meta name="theme-color" content="#26b0a1" />

    <!-- Synchronous Anti-FOUC Theme Script -->
    <script is:inline>
      (function () {
        try {
          const storedTheme = localStorage.getItem('theme');
          const systemPrefersDark = window.matchMedia && window.matchMedia('(prefers-color-scheme: dark)').matches;
          if (storedTheme === 'dark' || (!storedTheme && systemPrefersDark)) {
            document.documentElement.classList.add('dark');
          } else {
            document.documentElement.classList.remove('dark');
          }
        } catch (e) {
          // Fallback if localStorage is restricted
        }
      })();
    </script>

    <!-- Google tag (gtag.js) -->
    <script is:inline async src="https://www.googletagmanager.com/gtag/js?id=G-HSF2XCZEGC"></script>
    <script is:inline>
      window.dataLayer = window.dataLayer || [];
      function gtag(){dataLayer.push(arguments);}
      gtag('js', new Date());

      gtag('config', 'G-HSF2XCZEGC');
    </script>

    <!-- Robots and Indexing Controls -->
    <meta name="robots" content="index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1" />
    <meta name="googlebot" content="index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1" />
    <meta name="keywords" content={keywords} />
    <meta name="author" content="Make PNG" />
    <meta name="publisher" content="Make PNG" />

    <!-- Primary Meta Tags -->
    <title>{title}</title>
    <meta name="title" content={title} />
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalURL} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />

    <!-- 7 Bidirectional Hreflang Tags (en, es, pt, de, fr, ja, x-default) -->
    {
      hrefLangs.map(({ lang: hrefLang, href }) => (
        <link rel="alternate" hreflang={hrefLang} href={href} />
      ))
    }

    <!-- Open Graph / Facebook / WhatsApp / LinkedIn -->
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:title" content={ogTitle} />
    <meta property="og:description" content={ogDescription} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:secure_url" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="Make PNG - Free AI Background Remover Online Tool" />
    <meta property="og:image:type" content="image/png" />
    <meta property="og:site_name" content="Make PNG" />
    <meta property="og:locale" content={ogLocale} />

    <!-- Twitter Cards -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:url" content={canonicalURL} />
    <meta name="twitter:title" content={ogTitle} />
    <meta name="twitter:description" content={ogDescription} />
    <meta name="twitter:image" content={ogImage} />
    <meta name="twitter:image:alt" content="Make PNG - Free AI Background Remover Online Tool" />

    <!-- Localized JSON-LD Structured Data Multi-Entity Graph -->
    <script type="application/ld+json" is:inline set:html={JSON.stringify(structuredData)} />
  </head>

  <body class="min-h-screen flex flex-col bg-slate-50 dark:bg-slate-950 text-slate-900 dark:text-slate-100 selection:bg-[#26b0a1] selection:text-white antialiased transition-colors duration-200">
    <!-- Top Sticky Header -->
    <Header lang={lang} />

    <!-- Main Content -->
    <main class="flex-1 w-full overflow-x-hidden">
      <slot />
    </main>

    <!-- Responsive Footer -->
    <footer class="border-t border-slate-200 dark:border-slate-800/80 bg-white dark:bg-slate-950 transition-colors duration-200 mt-auto">
      <div
        class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 py-8 sm:py-10 flex flex-col sm:flex-row items-center justify-between gap-4 sm:gap-6"
      >
        <div class="text-center sm:text-left">
          <div class="flex items-center justify-center sm:justify-start gap-2">
            <div class="w-6 h-6 rounded-lg bg-[#26b0a1] flex items-center justify-center text-white text-xs font-bold shadow-xs">
              P
            </div>
            <p class="font-bold text-slate-900 dark:text-slate-100 tracking-tight">Make PNG</p>
          </div>
          <p class="text-xs sm:text-sm text-slate-500 dark:text-slate-400 mt-1">
            {t.footer.tagline}
          </p>
        </div>

        <div class="flex flex-wrap items-center justify-center gap-3 sm:gap-4">
          <a
            href="https://ko-fi.com/kishara"
            target="_blank"
            rel="noopener noreferrer"
            class="inline-flex items-center gap-1.5 sm:gap-2 bg-gradient-to-r from-amber-400 to-amber-500 hover:from-amber-500 hover:to-amber-600 text-amber-950 font-semibold px-4 py-2 rounded-xl text-xs sm:text-sm transition-all duration-200 shadow-sm hover:shadow active:scale-95 border border-amber-300/40"
            title={t.footer.support}
            aria-label={t.footer.support}
          >
            <svg
              xmlns="http://www.w3.org/2000/svg"
              class="h-4 w-4 text-amber-950 shrink-0"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2.2"
              stroke-linecap="round"
              stroke-linejoin="round"
            >
              <path d="M10 2v2"></path>
              <path d="M14 2v2"></path>
              <path
                d="M16 8a1 1 0 0 1 1 1v8a4 4 0 0 1-4 4H7a4 4 0 0 1-4-4V9a1 1 0 0 1 1-1h14a4 4 0 1 1 0 8h-1"
              ></path>
              <path d="M6 2v2"></path>
            </svg>
            <span class="sm:hidden">{t.nav.supportShort}</span>
            <span class="hidden sm:inline">{t.footer.support}</span>
          </a>

          <a
            href="https://github.com/makepng/makepng.github.io"
            target="_blank"
            rel="noopener noreferrer"
            class="text-xs sm:text-sm text-slate-500 dark:text-slate-400 hover:text-slate-900 dark:hover:text-slate-100 transition-colors py-2 px-3 rounded-lg hover:bg-slate-100 dark:hover:bg-slate-850"
          >
            {t.footer.github}
          </a>
        </div>
      </div>
    </footer>
  </body>
</html>
