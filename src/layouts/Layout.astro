---
import Navbar from '../components/Navbar.astro';
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
}

const {
  title = 'Make PNG | Free AI Background Remover (100% Private)',
  description = 'Instantly remove backgrounds from images for free. Our AI runs entirely in your browser, ensuring 100% privacy with zero server uploads or subscriptions.',
} = Astro.props;

const canonicalURL = new URL(Astro.url.pathname, Astro.site);
const ogTitle = 'Make PNG: Free In-Browser Background Remover';
const ogDescription =
  'Turn any photo into a transparent PNG instantly using local AI processing. No watermarks, no sign-ups.';
const ogImage =
  'https://res.cloudinary.com/dpx6w78bt/image/upload/f_auto/q_auto/v1786342039/Online_Tool_rc1ybr.png';
const keywords =
  'free background remover, ai background removal, transparent png maker, remove bg online, client side ai, in browser background remover, free png cutout, no watermark bg remover, cut out image free';
---

<!doctype html>
<html lang="en" class="scroll-smooth">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover" />
    <meta name="generator" content={Astro.generator} />
    <meta name="theme-color" content="#26b0a1" />

    <!-- Google tag (gtag.js) -->
    <script is:inline async src="https://www.googletagmanager.com/gtag/js?id=G-HSF2XCZEGC"></script>
    <script is:inline>
      window.dataLayer = window.dataLayer || [];
      function gtag(){dataLayer.push(arguments);}
      gtag('js', new Date());

      gtag('config', 'G-HSF2XCZEGC');
    </script>

    <!-- Robots and Indexing Controls -->
    <meta name="robots" content="index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1" />
    <meta name="googlebot" content="index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1" />
    <meta name="keywords" content={keywords} />
    <meta name="author" content="Make PNG" />
    <meta name="publisher" content="Make PNG" />

    <!-- Primary Meta Tags -->
    <title>{title}</title>
    <meta name="title" content={title} />
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalURL} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />

    <!-- Open Graph / Facebook / WhatsApp / LinkedIn -->
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:title" content={ogTitle} />
    <meta property="og:description" content={ogDescription} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:secure_url" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="Make PNG - Free AI Background Remover Online Tool" />
    <meta property="og:image:type" content="image/png" />
    <meta property="og:site_name" content="Make PNG" />
    <meta property="og:locale" content="en_US" />

    <!-- Twitter Cards -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:url" content={canonicalURL} />
    <meta name="twitter:title" content={ogTitle} />
    <meta name="twitter:description" content={ogDescription} />
    <meta name="twitter:image" content={ogImage} />
    <meta name="twitter:image:alt" content="Make PNG - Free AI Background Remover Online Tool" />

    <!-- Complete JSON-LD Structured Data Multi-Entity Graph -->
    <script type="application/ld+json" is:inline>
      {
        "@context": "https://schema.org",
        "@graph": [
          {
            "@type": "WebApplication",
            "@id": "https://makepng.github.io/#webapp",
            "name": "MakePNG AI Background Remover",
            "url": "https://makepng.github.io",
            "image": "https://res.cloudinary.com/dpx6w78bt/image/upload/f_auto/q_auto/v1786342039/Online_Tool_rc1ybr.png",
            "description": "Instantly remove backgrounds from images for free using in-browser AI. 100% private, zero server uploads, no sign-ups or subscriptions.",
            "applicationCategory": ["DesignApplication", "MultimediaApplication", "Photography"],
            "operatingSystem": "Any (Web Browser with WebAssembly support)",
            "browserRequirements": "Requires JavaScript and WebAssembly enabled",
            "offers": {
              "@type": "Offer",
              "price": "0",
              "priceCurrency": "USD",
              "availability": "https://schema.org/InStock"
            },
            "featureList": [
              "AI-powered background removal",
              "100% client-side processing",
              "No server uploads required",
              "Free with no watermarks",
              "Supports JPG, PNG, and WebP",
              "Full resolution PNG export"
            ]
          },
          {
            "@type": "HowTo",
            "@id": "https://makepng.github.io/#howto",
            "name": "How to Remove Image Background for Free",
            "description": "Step-by-step guide to removing backgrounds from photos online with 100% privacy using Make PNG.",
            "totalTime": "PT10S",
            "step": [
              {
                "@type": "HowToStep",
                "position": 1,
                "name": "Upload Image",
                "text": "Drag and drop your JPG, PNG, or WebP photo into the upload box or click to select from your device."
              },
              {
                "@type": "HowToStep",
                "position": 2,
                "name": "AI Processing",
                "text": "The neural network runs directly inside your browser to detect foreground subjects and erase the background automatically."
              },
              {
                "@type": "HowToStep",
                "position": 3,
                "name": "Preview Result",
                "text": "Inspect the transparent cutout on the checkered transparency canvas."
              },
              {
                "@type": "HowToStep",
                "position": 4,
                "name": "Download PNG",
                "text": "Click Download PNG to save your high-resolution cutout image instantly without watermarks."
              }
            ]
          },
          {
            "@type": "FAQPage",
            "@id": "https://makepng.github.io/#faq",
            "mainEntity": [
              {
                "@type": "Question",
                "name": "Is Make PNG completely free to use?",
                "acceptedAnswer": {
                  "@type": "Answer",
                  "text": "Yes, Make PNG is 100% free with no hidden subscriptions, no credit card requirements, no daily quotas, and absolutely no watermarks on exported images."
                }
              },
              {
                "@type": "Question",
                "name": "Are my images uploaded to any server or cloud?",
                "acceptedAnswer": {
                  "@type": "Answer",
                  "text": "No. Make PNG runs the AI neural network entirely inside your browser cache using WebAssembly and Web Workers. Your images never leave your computer or phone."
                }
              },
              {
                "@type": "Question",
                "name": "What image formats are supported?",
                "acceptedAnswer": {
                  "@type": "Answer",
                  "text": "Make PNG supports all standard image formats including JPG/JPEG, PNG, and WebP photos."
                }
              },
              {
                "@type": "Question",
                "name": "How fast is background removal?",
                "acceptedAnswer": {
                  "@type": "Answer",
                  "text": "Once the AI model is downloaded and cached in your browser on the first run, background removal typically completes in just 1 to 3 seconds."
                }
              }
            ]
          },
          {
            "@type": "BreadcrumbList",
            "@id": "https://makepng.github.io/#breadcrumbs",
            "itemListElement": [
              {
                "@type": "ListItem",
                "position": 1,
                "name": "Home",
                "item": "https://makepng.github.io/"
              }
            ]
          },
          {
            "@type": "Organization",
            "@id": "https://makepng.github.io/#organization",
            "name": "Make PNG",
            "url": "https://makepng.github.io",
            "logo": "https://makepng.github.io/favicon.svg"
          }
        ]
      }
    </script>
  </head>

  <body class="min-h-screen flex flex-col bg-slate-50 text-slate-900 selection:bg-brand-500 selection:text-white">
    <!-- Top Creative Navigation Bar -->
    <Navbar />

    <!-- Main Content -->
    <main class="flex-1 w-full overflow-x-hidden">
      <slot />
    </main>

    <!-- Responsive Footer -->
    <footer class="border-t border-slate-200 bg-white mt-auto">
      <div
        class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 py-8 sm:py-10 flex flex-col sm:flex-row items-center justify-between gap-4 sm:gap-6"
      >
        <div class="text-center sm:text-left">
          <div class="flex items-center justify-center sm:justify-start gap-2">
            <div class="w-6 h-6 rounded-lg bg-brand-500 flex items-center justify-center text-white text-xs font-bold shadow-xs">
              P
            </div>
            <p class="font-bold text-slate-900 tracking-tight">Make PNG</p>
          </div>
          <p class="text-xs sm:text-sm text-slate-500 mt-1">
            Free & 100% Client-Side AI · Open Source under MIT License.
          </p>
        </div>

        <div class="flex flex-wrap items-center justify-center gap-3 sm:gap-4">
          <a
            href="https://buymeacoffee.com/kisharadilz"
            target="_blank"
            rel="noopener noreferrer"
            class="inline-flex items-center gap-1.5 sm:gap-2 bg-amber-400 hover:bg-amber-500 text-amber-950 font-semibold px-4 py-2 rounded-xl text-xs sm:text-sm transition-all duration-200 shadow-sm hover:shadow active:scale-95"
            title="Support the Developer"
            aria-label="Support the Developer"
          >
            <svg
              xmlns="http://www.w3.org/2000/svg"
              class="h-4 w-4 text-amber-950"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2.2"
              stroke-linecap="round"
              stroke-linejoin="round"
            >
              <path d="M10 2v2"></path>
              <path d="M14 2v2"></path>
              <path
                d="M16 8a1 1 0 0 1 1 1v8a4 4 0 0 1-4 4H7a4 4 0 0 1-4-4V9a1 1 0 0 1 1-1h14a4 4 0 1 1 0 8h-1"
              ></path>
              <path d="M6 2v2"></path>
            </svg>
            <span class="sm:hidden">Support</span>
            <span class="hidden sm:inline">Support the Developer</span>
          </a>

          <a
            href="https://github.com/makepng/makepng.github.io"
            target="_blank"
            rel="noopener noreferrer"
            class="text-xs sm:text-sm text-slate-500 hover:text-slate-900 transition-colors py-2 px-3 rounded-lg hover:bg-slate-100"
          >
            GitHub
          </a>
        </div>
      </div>
    </footer>
  </body>
</html>
