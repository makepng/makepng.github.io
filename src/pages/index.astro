---
import Layout from '../layouts/Layout.astro';
import BackgroundRemover from '../components/BackgroundRemover.jsx';
---

<Layout>
  <!-- ==============================
       HERO + AI TOOL
       ============================== -->
  <section class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8 pt-8 sm:pt-14 pb-12 sm:pb-20">
    <!-- Hero Heading & Badge -->
    <div class="text-center mb-8 sm:mb-12">
      <div class="inline-flex items-center gap-2 px-3.5 py-1.5 rounded-full text-xs font-semibold bg-[#f0fbf9] text-[#1c756d] mb-4 sm:mb-6 border border-[#b0ece2] shadow-2xs">
        <span class="w-2 h-2 rounded-full bg-[#26b0a1] animate-pulse"></span>
        Zero Server Uploads · 100% Client-Side
      </div>

      <h1 class="text-3xl sm:text-5xl md:text-6xl font-extrabold text-slate-900 tracking-tight leading-[1.15] sm:leading-[1.1]">
        Remove Any Background
        <span class="block text-[#26b0a1] mt-1 sm:mt-2">
          Instantly & Privately
        </span>
      </h1>
      <p class="mt-3.5 sm:mt-5 text-sm sm:text-lg md:text-xl text-slate-600 max-w-2xl mx-auto leading-relaxed px-2">
        Turn any photo into a transparent PNG using in-browser AI. No sign-ups, no file size limits, and no watermarks — ever.
      </p>
    </div>

    <!-- Core Tool (React Island) -->
    <BackgroundRemover client:load />
  </section>

  <!-- ==============================
       HOW-TO GUIDE  (4 steps)
       ============================== -->
  <section id="how-it-works" class="bg-white border-y border-slate-200 scroll-mt-20">
    <div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8 py-12 sm:py-20">
      <div class="text-center max-w-2xl mx-auto mb-10 sm:mb-14">
        <h2 class="text-2xl sm:text-3xl md:text-4xl font-bold text-slate-900 tracking-tight">
          How to Remove Background for Free
        </h2>
        <p class="text-slate-500 text-sm sm:text-base mt-2">
          Four simple steps — no software installation or account required.
        </p>
      </div>

      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4 sm:gap-6">
        <!-- Step 1 -->
        <div class="relative rounded-2xl border border-slate-200 bg-slate-50/80 p-5 sm:p-6 shadow-xs hover:shadow-md transition-all duration-300">
          <span class="absolute -top-3 -left-2.5 sm:-left-3 flex items-center justify-center w-7 h-7 sm:w-8 sm:h-8 rounded-full bg-[#26b0a1] text-white text-xs sm:text-sm font-bold shadow-md shadow-[#26b0a1]/30">
            1
          </span>
          <div class="text-3xl mb-3 mt-1">📤</div>
          <h3 class="font-bold text-slate-900 text-base sm:text-lg">Upload</h3>
          <p class="text-xs sm:text-sm text-slate-500 mt-1 leading-relaxed">
            Drag and drop your JPG, PNG, or WebP image into the upload area.
          </p>
        </div>

        <!-- Step 2 -->
        <div class="relative rounded-2xl border border-slate-200 bg-slate-50/80 p-5 sm:p-6 shadow-xs hover:shadow-md transition-all duration-300">
          <span class="absolute -top-3 -left-2.5 sm:-left-3 flex items-center justify-center w-7 h-7 sm:w-8 sm:h-8 rounded-full bg-[#26b0a1] text-white text-xs sm:text-sm font-bold shadow-md shadow-[#26b0a1]/30">
            2
          </span>
          <div class="text-3xl mb-3 mt-1">🤖</div>
          <h3 class="font-bold text-slate-900 text-base sm:text-lg">AI Processes</h3>
          <p class="text-xs sm:text-sm text-slate-500 mt-1 leading-relaxed">
            In-browser neural network automatically detects and cuts out the subject.
          </p>
        </div>

        <!-- Step 3 -->
        <div class="relative rounded-2xl border border-slate-200 bg-slate-50/80 p-5 sm:p-6 shadow-xs hover:shadow-md transition-all duration-300">
          <span class="absolute -top-3 -left-2.5 sm:-left-3 flex items-center justify-center w-7 h-7 sm:w-8 sm:h-8 rounded-full bg-[#26b0a1] text-white text-xs sm:text-sm font-bold shadow-md shadow-[#26b0a1]/30">
            3
          </span>
          <div class="text-3xl mb-3 mt-1">👁️</div>
          <h3 class="font-bold text-slate-900 text-base sm:text-lg">Preview</h3>
          <p class="text-xs sm:text-sm text-slate-500 mt-1 leading-relaxed">
            Inspect the transparent cutout on the checkered transparency canvas.
          </p>
        </div>

        <!-- Step 4 -->
        <div class="relative rounded-2xl border border-slate-200 bg-slate-50/80 p-5 sm:p-6 shadow-xs hover:shadow-md transition-all duration-300">
          <span class="absolute -top-3 -left-2.5 sm:-left-3 flex items-center justify-center w-7 h-7 sm:w-8 sm:h-8 rounded-full bg-[#26b0a1] text-white text-xs sm:text-sm font-bold shadow-md shadow-[#26b0a1]/30">
            4
          </span>
          <div class="text-3xl mb-3 mt-1">💾</div>
          <h3 class="font-bold text-slate-900 text-base sm:text-lg">Download</h3>
          <p class="text-xs sm:text-sm text-slate-500 mt-1 leading-relaxed">
            Click "Download PNG" to save your high-resolution cutout instantly.
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- ==============================
       WHY CHOOSE MAKE PNG?
       ============================== -->
  <section id="why-makepng" class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8 py-12 sm:py-20 scroll-mt-20">
    <div class="text-center max-w-2xl mx-auto mb-10 sm:mb-14">
      <h2 class="text-2xl sm:text-3xl md:text-4xl font-bold text-slate-900 tracking-tight">
        Why Choose Make PNG?
      </h2>
      <p class="text-slate-500 text-sm sm:text-base mt-2">
        Engineered for ultimate speed, total privacy, and ease of use.
      </p>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-3 gap-4 sm:gap-6">
      <!-- Privacy -->
      <div class="rounded-2xl sm:rounded-3xl border border-slate-200 bg-white p-6 sm:p-8 shadow-xs hover:shadow-md transition-all duration-300">
        <div class="flex items-center justify-center w-11 h-11 sm:w-12 sm:h-12 rounded-2xl bg-[#f0fbf9] text-[#26b0a1] border border-[#b0ece2] mb-4 sm:mb-5 shadow-2xs">
          <svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <rect width="18" height="11" x="3" y="11" rx="2" ry="2"></rect>
            <path d="M7 11V7a5 5 0 0 1 10 0v4"></path>
          </svg>
        </div>
        <h3 class="text-base sm:text-lg font-bold text-slate-900">Uncompromised Privacy</h3>
        <p class="text-xs sm:text-sm text-slate-500 mt-2 leading-relaxed">
          Powered by WebAssembly & ONNX runtime. Your photos never leave your device and are <strong>never uploaded to the cloud</strong>.
        </p>
      </div>

      <!-- Free -->
      <div class="rounded-2xl sm:rounded-3xl border border-slate-200 bg-white p-6 sm:p-8 shadow-xs hover:shadow-md transition-all duration-300">
        <div class="flex items-center justify-center w-11 h-11 sm:w-12 sm:h-12 rounded-2xl bg-emerald-100 text-emerald-600 mb-4 sm:mb-5 shadow-2xs">
          <svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M12 2v20M17 5H9.5a3.5 3.5 0 0 0 0 7h5a3.5 3.5 0 0 1 0 7H6"></path>
          </svg>
        </div>
        <h3 class="text-base sm:text-lg font-bold text-slate-900">Completely Free</h3>
        <p class="text-xs sm:text-sm text-slate-500 mt-2 leading-relaxed">
          No credit card, no subscription traps, no daily limits, and <strong>no watermarks</strong>. Unlimited exports forever.
        </p>
      </div>

      <!-- Fast -->
      <div class="rounded-2xl sm:rounded-3xl border border-slate-200 bg-white p-6 sm:p-8 shadow-xs hover:shadow-md transition-all duration-300">
        <div class="flex items-center justify-center w-11 h-11 sm:w-12 sm:h-12 rounded-2xl bg-amber-100 text-amber-600 mb-4 sm:mb-5 shadow-2xs">
          <svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M13 2 3 14h9l-1 8 10-12h-9l1-8z"></path>
          </svg>
        </div>
        <h3 class="text-base sm:text-lg font-bold text-slate-900">Lightning Fast</h3>
        <p class="text-xs sm:text-sm text-slate-500 mt-2 leading-relaxed">
          Once the AI model is cached locally in your browser, background removal runs in <strong>seconds</strong> without server latency.
        </p>
      </div>
    </div>
  </section>

  <!-- ==============================
       FREQUENTLY ASKED QUESTIONS (FAQ)
       ============================== -->
  <section id="faq" class="bg-white border-t border-slate-200 scroll-mt-20">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 py-12 sm:py-20">
      <div class="text-center max-w-2xl mx-auto mb-10 sm:mb-14">
        <h2 class="text-2xl sm:text-3xl md:text-4xl font-bold text-slate-900 tracking-tight">
          Frequently Asked Questions
        </h2>
        <p class="text-slate-500 text-sm sm:text-base mt-2">
          Everything you need to know about Make PNG's in-browser AI tool.
        </p>
      </div>

      <div class="space-y-4">
        <!-- Question 1 -->
        <div class="rounded-2xl border border-slate-200 p-5 sm:p-6 bg-slate-50/50 hover:bg-slate-50 transition-colors">
          <h3 class="text-base sm:text-lg font-bold text-slate-900 flex items-center gap-2.5">
            <span class="text-[#26b0a1] font-extrabold text-lg">Q.</span>
            Is Make PNG completely free to use?
          </h3>
          <p class="text-xs sm:text-sm text-slate-600 mt-2.5 pl-6 leading-relaxed">
            Yes! Make PNG is 100% free forever. There are no subscriptions, no daily limits, no account sign-up requirements, and zero watermarks added to your exported transparent PNG files.
          </p>
        </div>

        <!-- Question 2 -->
        <div class="rounded-2xl border border-slate-200 p-5 sm:p-6 bg-slate-50/50 hover:bg-slate-50 transition-colors">
          <h3 class="text-base sm:text-lg font-bold text-slate-900 flex items-center gap-2.5">
            <span class="text-[#26b0a1] font-extrabold text-lg">Q.</span>
            Are my images uploaded to any cloud server?
          </h3>
          <p class="text-xs sm:text-sm text-slate-600 mt-2.5 pl-6 leading-relaxed">
            No, never. Make PNG uses state-of-the-art WebAssembly and ONNX Runtime to execute the entire AI neural network directly in your local browser cache. Your photos never leave your device.
          </p>
        </div>

        <!-- Question 3 -->
        <div class="rounded-2xl border border-slate-200 p-5 sm:p-6 bg-slate-50/50 hover:bg-slate-50 transition-colors">
          <h3 class="text-base sm:text-lg font-bold text-slate-900 flex items-center gap-2.5">
            <span class="text-[#26b0a1] font-extrabold text-lg">Q.</span>
            What image formats can I upload?
          </h3>
          <p class="text-xs sm:text-sm text-slate-600 mt-2.5 pl-6 leading-relaxed">
            Make PNG supports all major standard web image formats including JPG, JPEG, PNG, and WebP files. You can download the cutout as a crisp, full-resolution transparent PNG.
          </p>
        </div>

        <!-- Question 4 -->
        <div class="rounded-2xl border border-slate-200 p-5 sm:p-6 bg-slate-50/50 hover:bg-slate-50 transition-colors">
          <h3 class="text-base sm:text-lg font-bold text-slate-900 flex items-center gap-2.5">
            <span class="text-[#26b0a1] font-extrabold text-lg">Q.</span>
            How fast is the background removal process?
          </h3>
          <p class="text-xs sm:text-sm text-slate-600 mt-2.5 pl-6 leading-relaxed">
            After the initial AI model download is cached in your browser on the first use, all subsequent background removals happen in approximately 1 to 3 seconds with zero network latency.
          </p>
        </div>
      </div>
    </div>
  </section>
</Layout>
