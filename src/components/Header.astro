---
import LanguagePicker from './LanguagePicker.astro';
import ThemeToggle from './ThemeToggle.astro';
import { type SupportedLocale } from '../i18n/ui';
import { getLangFromUrl, useTranslations, getLocalizedPath } from '../i18n/utils';

interface Props {
  lang?: SupportedLocale;
}

const { lang: propLang } = Astro.props;
const currentLang = propLang || getLangFromUrl(Astro.url);
const t = useTranslations(currentLang);
const homeHref = getLocalizedPath('/', currentLang);
---

<header class="sticky top-0 z-50 w-full bg-white/85 dark:bg-slate-950/85 backdrop-blur-md border-b border-slate-200/80 dark:border-slate-800/80 transition-colors duration-200">
  <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 h-16 flex items-center justify-between gap-2 sm:gap-4">
    <!-- Brand / Logo -->
    <a
      href={homeHref}
      class="flex items-center gap-2.5 group focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-[#26b0a1] rounded-xl p-1 -ml-1 transition-transform active:scale-95 shrink-0"
      aria-label="Make PNG Homepage"
    >
      <div class="w-9 h-9 sm:w-10 sm:h-10 rounded-xl bg-[#26b0a1] flex items-center justify-center text-white shadow-md shadow-[#26b0a1]/30 group-hover:shadow-lg group-hover:shadow-[#26b0a1]/40 group-hover:scale-105 transition-all duration-300">
        <svg
          xmlns="http://www.w3.org/2000/svg"
          class="w-5 h-5 text-white"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2.2"
          stroke-linecap="round"
          stroke-linejoin="round"
          aria-hidden="true"
        >
          <!-- Scissors cutting image background / transparency wand -->
          <path d="M6 3v12" />
          <circle cx="6" cy="18" r="3" />
          <path d="M18 9a3 3 0 1 0 0-6 3 3 0 0 0 0 6Z" />
          <path d="m6 6 12 12" />
        </svg>
      </div>
      <div class="flex items-center gap-2">
        <span class="text-base sm:text-lg font-bold text-slate-900 dark:text-slate-100 tracking-tight group-hover:text-[#26b0a1] transition-colors">
          Make<span class="text-[#26b0a1]">PNG</span>
        </span>
        <span class="hidden xl:inline-flex items-center px-2 py-0.5 rounded-full text-[11px] font-semibold bg-[#f0fbf9] dark:bg-teal-950/60 text-[#1c756d] dark:text-teal-300 border border-[#b0ece2] dark:border-teal-800">
          {t.nav.badge}
        </span>
      </div>
    </a>

    <!-- Navigation Links (Desktop Only - lg+) -->
    <nav class="hidden lg:flex items-center gap-6 text-sm font-medium text-slate-600 dark:text-slate-300" aria-label="Main Navigation">
      <a
        href="#how-it-works"
        class="hover:text-brand-600 dark:hover:text-brand-400 transition-colors hover:scale-105 duration-150"
      >
        {t.nav.howItWorks}
      </a>
      <a
        href="#why-makepng"
        class="hover:text-brand-600 dark:hover:text-brand-400 transition-colors hover:scale-105 duration-150"
      >
        {t.nav.whyMakePng}
      </a>
      <a
        href="#faq"
        class="hover:text-brand-600 dark:hover:text-brand-400 transition-colors hover:scale-105 duration-150"
      >
        {t.nav.faq}
      </a>
      <div class="flex items-center gap-1.5 text-xs text-emerald-700 dark:text-emerald-300 bg-emerald-50 dark:bg-emerald-950/50 px-2.5 py-1 rounded-full border border-emerald-200/60 dark:border-emerald-800/60 font-medium">
        <span class="w-1.5 h-1.5 rounded-full bg-emerald-500 animate-pulse"></span>
        {t.nav.privateBadge}
      </div>
    </nav>

    <!-- Actions (Language Picker + Theme Toggle + Support CTA + GitHub) -->
    <div class="flex items-center gap-1.5 sm:gap-2.5">
      <!-- Language Picker Dropdown -->
      <LanguagePicker currentLang={currentLang} />

      <!-- Theme Switcher (Dark/Light) -->
      <ThemeToggle />

      <!-- Support Coffee Button -->
      <a
        href="https://buymeacoffee.com/kisharadilz"
        target="_blank"
        rel="noopener noreferrer"
        class="inline-flex items-center gap-1.5 sm:gap-2 bg-gradient-to-r from-amber-400 to-amber-500 hover:from-amber-500 hover:to-amber-600 text-amber-950 font-semibold px-2.5 py-1.5 sm:px-3.5 sm:py-2 rounded-xl text-xs sm:text-sm transition-all duration-200 shadow-sm hover:shadow-md active:scale-95 border border-amber-300/40 shrink-0"
        title={t.nav.supportFull}
        aria-label={t.nav.supportFull}
      >
        <!-- Coffee Cup SVG Icon -->
        <svg
          xmlns="http://www.w3.org/2000/svg"
          class="h-4 w-4 shrink-0 text-amber-950"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2.2"
          stroke-linecap="round"
          stroke-linejoin="round"
          aria-hidden="true"
        >
          <path d="M10 2v2"></path>
          <path d="M14 2v2"></path>
          <path d="M16 8a1 1 0 0 1 1 1v8a4 4 0 0 1-4 4H7a4 4 0 0 1-4-4V9a1 1 0 0 1 1-1h14a4 4 0 1 1 0 8h-1"></path>
          <path d="M6 2v2"></path>
        </svg>
        <!-- Mobile/Tablet view (< sm or md): short text -->
        <span class="sm:hidden font-semibold">{t.nav.supportShort}</span>
        <!-- Larger view (>= sm): full text -->
        <span class="hidden sm:inline font-semibold">{t.nav.supportFull}</span>
      </a>

      <!-- GitHub Link Icon -->
      <a
        href="https://github.com/makepng/makepng.github.io"
        target="_blank"
        rel="noopener noreferrer"
        class="p-2 text-slate-500 hover:text-slate-900 dark:text-slate-400 dark:hover:text-slate-100 hover:bg-slate-100 dark:hover:bg-slate-800 rounded-xl transition-all duration-200 hidden xs:inline-flex"
        aria-label={t.nav.github}
        title={t.nav.github}
      >
        <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24" aria-hidden="true">
          <path fill-rule="evenodd" d="M12 2C6.477 2 2 6.484 2 12.017c0 4.425 2.865 8.18 6.839 9.504.5.092.682-.217.682-.483 0-.237-.008-.868-.013-1.703-2.782.605-3.369-1.343-3.369-1.343-.454-1.158-1.11-1.466-1.11-1.466-.908-.62.069-.608.069-.608 1.003.07 1.53 1.032 1.53 1.032.892 1.53 2.341 1.088 2.91.832.092-.647.35-1.088.636-1.338-2.22-.253-4.555-1.113-4.555-4.951 0-1.093.39-1.988 1.029-2.688-.103-.253-.446-1.272.098-2.65 0 0 .84-.27 2.75 1.026A9.564 9.564 0 0112 6.844c.85.004 1.705.115 2.504.337 1.909-1.296 2.747-1.027 2.747-1.027.546 1.379.202 2.398.1 2.651.64.7 1.028 1.595 1.028 2.688 0 3.848-2.339 4.695-4.566 4.943.359.309.678.92.678 1.855 0 1.338-.012 2.419-.012 2.747 0 .268.18.58.688.482A10.019 10.019 0 0022 12.017C22 6.484 17.522 2 12 2z" clip-rule="evenodd" />
        </svg>
      </a>
    </div>
  </div>
</header>
