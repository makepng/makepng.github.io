---
---

<header class="sticky top-0 z-50 w-full bg-white/80 backdrop-blur-md border-b border-slate-200/80 transition-all duration-200">
  <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 h-16 flex items-center justify-between gap-2 sm:gap-4">
    <!-- Brand / Logo -->
    <a
      href="/"
      class="flex items-center gap-2.5 group focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-[#26b0a1] rounded-xl p-1 -ml-1 transition-transform active:scale-95"
      aria-label="Make PNG Homepage"
    >
      <div class="w-9 h-9 sm:w-10 sm:h-10 rounded-xl bg-[#26b0a1] flex items-center justify-center text-white shadow-md shadow-[#26b0a1]/30 group-hover:shadow-lg group-hover:shadow-[#26b0a1]/40 group-hover:scale-105 transition-all duration-300">
        <svg
          xmlns="http://www.w3.org/2000/svg"
          class="w-5 h-5 text-white"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2.2"
          stroke-linecap="round"
          stroke-linejoin="round"
        >
          <!-- Scissors cutting image background / transparency wand -->
          <path d="M6 3v12" />
          <circle cx="6" cy="18" r="3" />
          <path d="M18 9a3 3 0 1 0 0-6 3 3 0 0 0 0 6Z" />
          <path d="m6 6 12 12" />
        </svg>
      </div>
      <div class="flex items-center gap-2">
        <span class="text-base sm:text-lg font-bold text-slate-900 tracking-tight group-hover:text-[#26b0a1] transition-colors">
          Make<span class="text-[#26b0a1]">PNG</span>
        </span>
        <span class="hidden lg:inline-flex items-center px-2 py-0.5 rounded-full text-[11px] font-semibold bg-[#f0fbf9] text-[#1c756d] border border-[#b0ece2]">
          Client-Side AI
        </span>
      </div>
    </a>

    <!-- Navigation Links (Desktop Only - lg+) -->
    <nav class="hidden lg:flex items-center gap-6 text-sm font-medium text-slate-600" aria-label="Main Navigation">
      <a
        href="#how-it-works"
        class="hover:text-brand-600 transition-colors hover:scale-105 duration-150"
      >
        How it Works
      </a>
      <a
        href="#why-makepng"
        class="hover:text-brand-600 transition-colors hover:scale-105 duration-150"
      >
        Why Make PNG
      </a>
      <a
        href="#faq"
        class="hover:text-brand-600 transition-colors hover:scale-105 duration-150"
      >
        FAQ
      </a>
      <div class="flex items-center gap-1.5 text-xs text-emerald-700 bg-emerald-50 px-2.5 py-1 rounded-full border border-emerald-200/60 font-medium">
        <span class="w-1.5 h-1.5 rounded-full bg-emerald-500 animate-pulse"></span>
        100% Private
      </div>
    </nav>

    <!-- Actions (Coffee Support CTA + GitHub) -->
    <div class="flex items-center gap-2 sm:gap-3">
      <!-- Support Coffee Button (Mobile & Tablet: 'Support', Desktop: 'Support the Developer') -->
      <a
        href="https://buymeacoffee.com/kisharadilz"
        target="_blank"
        rel="noopener noreferrer"
        class="inline-flex items-center gap-1.5 sm:gap-2 bg-gradient-to-r from-amber-400 to-amber-500 hover:from-amber-500 hover:to-amber-600 text-amber-950 font-semibold px-3 py-2 sm:px-3.5 sm:py-2 rounded-xl text-xs sm:text-sm transition-all duration-200 shadow-sm hover:shadow-md active:scale-95 border border-amber-300/40 shrink-0"
        title="Support the Developer"
        aria-label="Support the Developer"
      >
        <!-- Coffee Cup SVG Icon -->
        <svg
          xmlns="http://www.w3.org/2000/svg"
          class="h-4 w-4 shrink-0 text-amber-950"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2.2"
          stroke-linecap="round"
          stroke-linejoin="round"
        >
          <path d="M10 2v2"></path>
          <path d="M14 2v2"></path>
          <path d="M16 8a1 1 0 0 1 1 1v8a4 4 0 0 1-4 4H7a4 4 0 0 1-4-4V9a1 1 0 0 1 1-1h14a4 4 0 1 1 0 8h-1"></path>
          <path d="M6 2v2"></path>
        </svg>
        <!-- Mobile & Tablet view (< lg): just 'Support' text -->
        <span class="lg:hidden font-semibold">Support</span>
        <!-- Desktop view (≥ lg): 'Support the Developer' text -->
        <span class="hidden lg:inline font-semibold">Support the Developer</span>
      </a>

      <!-- GitHub Link Icon -->
      <a
        href="https://github.com/makepng/makepng.github.io"
        target="_blank"
        rel="noopener noreferrer"
        class="p-2 text-slate-500 hover:text-slate-900 hover:bg-slate-100 rounded-xl transition-all duration-200"
        aria-label="GitHub Repository"
        title="View on GitHub"
      >
        <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24" aria-hidden="true">
          <path fill-rule="evenodd" d="M12 2C6.477 2 2 6.484 2 12.017c0 4.425 2.865 8.18 6.839 9.504.5.092.682-.217.682-.483 0-.237-.008-.868-.013-1.703-2.782.605-3.369-1.343-3.369-1.343-.454-1.158-1.11-1.466-1.11-1.466-.908-.62.069-.608.069-.608 1.003.07 1.53 1.032 1.53 1.032.892 1.53 2.341 1.088 2.91.832.092-.647.35-1.088.636-1.338-2.22-.253-4.555-1.113-4.555-4.951 0-1.093.39-1.988 1.029-2.688-.103-.253-.446-1.272.098-2.65 0 0 .84-.27 2.75 1.026A9.564 9.564 0 0112 6.844c.85.004 1.705.115 2.504.337 1.909-1.296 2.747-1.027 2.747-1.027.546 1.379.202 2.398.1 2.651.64.7 1.028 1.595 1.028 2.688 0 3.848-2.339 4.695-4.566 4.943.359.309.678.92.678 1.855 0 1.338-.012 2.419-.012 2.747 0 .268.18.58.688.482A10.019 10.019 0 0022 12.017C22 6.484 17.522 2 12 2z" clip-rule="evenodd" />
        </svg>
      </a>
    </div>
  </div>
</header>
