---
import BackgroundRemover from './BackgroundRemover.jsx';
import { type SupportedLocale } from '../i18n/ui';
import { useTranslations } from '../i18n/utils';

interface Props {
  lang?: SupportedLocale;
}

const { lang = 'en' } = Astro.props;
const t = useTranslations(lang);
---

<div class="w-full">
  <!-- ==============================
       HERO + AI TOOL
       ============================== -->
  <section class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8 pt-8 sm:pt-14 pb-12 sm:pb-20">
    <!-- Hero Heading & Badge -->
    <div class="text-center mb-8 sm:mb-12">
      <div class="inline-flex items-center gap-2 px-3.5 py-1.5 rounded-full text-xs font-semibold bg-[#f0fbf9] dark:bg-teal-950/60 text-[#1c756d] dark:text-teal-300 mb-4 sm:mb-6 border border-[#b0ece2] dark:border-teal-800 shadow-2xs">
        <span class="w-2 h-2 rounded-full bg-[#26b0a1] animate-pulse"></span>
        {t.workspace.heroBadge}
      </div>

      <h1 class="text-3xl sm:text-5xl md:text-6xl font-extrabold text-slate-900 dark:text-slate-100 tracking-tight leading-[1.15] sm:leading-[1.1]">
        {t.workspace.heroTitle1}
        <span class="block text-[#26b0a1] mt-1 sm:mt-2">
          {t.workspace.heroTitle2}
        </span>
      </h1>
      <p class="mt-3.5 sm:mt-5 text-sm sm:text-lg md:text-xl text-slate-600 dark:text-slate-300 max-w-2xl mx-auto leading-relaxed px-2">
        {t.workspace.heroSubtitle}
      </p>
    </div>

    <!-- Core Tool (React Island with client:load) -->
    <BackgroundRemover client:load labels={t.workspace} />
  </section>

  <!-- ==============================
       HOW-TO GUIDE (4 steps)
       ============================== -->
  <section id="how-it-works" class="bg-white dark:bg-slate-900/60 border-y border-slate-200 dark:border-slate-800/80 scroll-mt-20 transition-colors duration-200">
    <div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8 py-12 sm:py-20">
      <div class="text-center max-w-2xl mx-auto mb-10 sm:mb-14">
        <h2 class="text-2xl sm:text-3xl md:text-4xl font-bold text-slate-900 dark:text-slate-100 tracking-tight">
          {t.howItWorks.title}
        </h2>
        <p class="text-slate-500 dark:text-slate-400 text-sm sm:text-base mt-2">
          {t.howItWorks.subtitle}
        </p>
      </div>

      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4 sm:gap-6">
        <!-- Step 1 -->
        <div class="relative rounded-2xl border border-slate-200 dark:border-slate-800 bg-slate-50/80 dark:bg-slate-900 p-5 sm:p-6 shadow-xs hover:shadow-md transition-all duration-300">
          <span class="absolute -top-3 -left-2.5 sm:-left-3 flex items-center justify-center w-7 h-7 sm:w-8 sm:h-8 rounded-full bg-[#26b0a1] text-white text-xs sm:text-sm font-bold shadow-md shadow-[#26b0a1]/30">
            1
          </span>
          <div class="text-3xl mb-3 mt-1" aria-hidden="true">📤</div>
          <h3 class="font-bold text-slate-900 dark:text-slate-100 text-base sm:text-lg">{t.howItWorks.step1Title}</h3>
          <p class="text-xs sm:text-sm text-slate-500 dark:text-slate-400 mt-1 leading-relaxed">
            {t.howItWorks.step1Desc}
          </p>
        </div>

        <!-- Step 2 -->
        <div class="relative rounded-2xl border border-slate-200 dark:border-slate-800 bg-slate-50/80 dark:bg-slate-900 p-5 sm:p-6 shadow-xs hover:shadow-md transition-all duration-300">
          <span class="absolute -top-3 -left-2.5 sm:-left-3 flex items-center justify-center w-7 h-7 sm:w-8 sm:h-8 rounded-full bg-[#26b0a1] text-white text-xs sm:text-sm font-bold shadow-md shadow-[#26b0a1]/30">
            2
          </span>
          <div class="text-3xl mb-3 mt-1" aria-hidden="true">🤖</div>
          <h3 class="font-bold text-slate-900 dark:text-slate-100 text-base sm:text-lg">{t.howItWorks.step2Title}</h3>
          <p class="text-xs sm:text-sm text-slate-500 dark:text-slate-400 mt-1 leading-relaxed">
            {t.howItWorks.step2Desc}
          </p>
        </div>

        <!-- Step 3 -->
        <div class="relative rounded-2xl border border-slate-200 dark:border-slate-800 bg-slate-50/80 dark:bg-slate-900 p-5 sm:p-6 shadow-xs hover:shadow-md transition-all duration-300">
          <span class="absolute -top-3 -left-2.5 sm:-left-3 flex items-center justify-center w-7 h-7 sm:w-8 sm:h-8 rounded-full bg-[#26b0a1] text-white text-xs sm:text-sm font-bold shadow-md shadow-[#26b0a1]/30">
            3
          </span>
          <div class="text-3xl mb-3 mt-1" aria-hidden="true">👁️</div>
          <h3 class="font-bold text-slate-900 dark:text-slate-100 text-base sm:text-lg">{t.howItWorks.step3Title}</h3>
          <p class="text-xs sm:text-sm text-slate-500 dark:text-slate-400 mt-1 leading-relaxed">
            {t.howItWorks.step3Desc}
          </p>
        </div>

        <!-- Step 4 -->
        <div class="relative rounded-2xl border border-slate-200 dark:border-slate-800 bg-slate-50/80 dark:bg-slate-900 p-5 sm:p-6 shadow-xs hover:shadow-md transition-all duration-300">
          <span class="absolute -top-3 -left-2.5 sm:-left-3 flex items-center justify-center w-7 h-7 sm:w-8 sm:h-8 rounded-full bg-[#26b0a1] text-white text-xs sm:text-sm font-bold shadow-md shadow-[#26b0a1]/30">
            4
          </span>
          <div class="text-3xl mb-3 mt-1" aria-hidden="true">💾</div>
          <h3 class="font-bold text-slate-900 dark:text-slate-100 text-base sm:text-lg">{t.howItWorks.step4Title}</h3>
          <p class="text-xs sm:text-sm text-slate-500 dark:text-slate-400 mt-1 leading-relaxed">
            {t.howItWorks.step4Desc}
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- ==============================
       WHY CHOOSE MAKE PNG?
       ============================== -->
  <section id="why-makepng" class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8 py-12 sm:py-20 scroll-mt-20">
    <div class="text-center max-w-2xl mx-auto mb-10 sm:mb-14">
      <h2 class="text-2xl sm:text-3xl md:text-4xl font-bold text-slate-900 dark:text-slate-100 tracking-tight">
        {t.whyMakePng.title}
      </h2>
      <p class="text-slate-500 dark:text-slate-400 text-sm sm:text-base mt-2">
        {t.whyMakePng.subtitle}
      </p>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-3 gap-4 sm:gap-6">
      <!-- Privacy -->
      <div class="rounded-2xl sm:rounded-3xl border border-slate-200 dark:border-slate-800 bg-white dark:bg-slate-900 p-6 sm:p-8 shadow-xs hover:shadow-md transition-all duration-300">
        <div class="flex items-center justify-center w-11 h-11 sm:w-12 sm:h-12 rounded-2xl bg-[#f0fbf9] dark:bg-teal-950/60 text-[#26b0a1] dark:text-teal-400 border border-[#b0ece2] dark:border-teal-800 mb-4 sm:mb-5 shadow-2xs">
          <svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <rect width="18" height="11" x="3" y="11" rx="2" ry="2"></rect>
            <path d="M7 11V7a5 5 0 0 1 10 0v4"></path>
          </svg>
        </div>
        <h3 class="text-base sm:text-lg font-bold text-slate-900 dark:text-slate-100">{t.whyMakePng.feature1Title}</h3>
        <p class="text-xs sm:text-sm text-slate-500 dark:text-slate-400 mt-2 leading-relaxed">
          {t.whyMakePng.feature1Desc}
        </p>
      </div>

      <!-- Free -->
      <div class="rounded-2xl sm:rounded-3xl border border-slate-200 dark:border-slate-800 bg-white dark:bg-slate-900 p-6 sm:p-8 shadow-xs hover:shadow-md transition-all duration-300">
        <div class="flex items-center justify-center w-11 h-11 sm:w-12 sm:h-12 rounded-2xl bg-emerald-100 dark:bg-emerald-950/60 text-emerald-600 dark:text-emerald-400 border border-emerald-200 dark:border-emerald-800 mb-4 sm:mb-5 shadow-2xs">
          <svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M12 2v20M17 5H9.5a3.5 3.5 0 0 0 0 7h5a3.5 3.5 0 0 1 0 7H6"></path>
          </svg>
        </div>
        <h3 class="text-base sm:text-lg font-bold text-slate-900 dark:text-slate-100">{t.whyMakePng.feature2Title}</h3>
        <p class="text-xs sm:text-sm text-slate-500 dark:text-slate-400 mt-2 leading-relaxed">
          {t.whyMakePng.feature2Desc}
        </p>
      </div>

      <!-- Fast -->
      <div class="rounded-2xl sm:rounded-3xl border border-slate-200 dark:border-slate-800 bg-white dark:bg-slate-900 p-6 sm:p-8 shadow-xs hover:shadow-md transition-all duration-300">
        <div class="flex items-center justify-center w-11 h-11 sm:w-12 sm:h-12 rounded-2xl bg-amber-100 dark:bg-amber-950/60 text-amber-600 dark:text-amber-400 border border-amber-200 dark:border-amber-800 mb-4 sm:mb-5 shadow-2xs">
          <svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M13 2 3 14h9l-1 8 10-12h-9l1-8z"></path>
          </svg>
        </div>
        <h3 class="text-base sm:text-lg font-bold text-slate-900 dark:text-slate-100">{t.whyMakePng.feature3Title}</h3>
        <p class="text-xs sm:text-sm text-slate-500 dark:text-slate-400 mt-2 leading-relaxed">
          {t.whyMakePng.feature3Desc}
        </p>
      </div>
    </div>
  </section>

  <!-- ==============================
       FREQUENTLY ASKED QUESTIONS (FAQ)
       ============================== -->
  <section id="faq" class="bg-white dark:bg-slate-900/60 border-t border-slate-200 dark:border-slate-800/80 scroll-mt-20 transition-colors duration-200">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 py-12 sm:py-20">
      <div class="text-center max-w-2xl mx-auto mb-10 sm:mb-14">
        <h2 class="text-2xl sm:text-3xl md:text-4xl font-bold text-slate-900 dark:text-slate-100 tracking-tight">
          {t.faq.title}
        </h2>
        <p class="text-slate-500 dark:text-slate-400 text-sm sm:text-base mt-2">
          {t.faq.subtitle}
        </p>
      </div>

      <div class="space-y-4">
        <!-- Question 1 -->
        <div class="rounded-2xl border border-slate-200 dark:border-slate-800 p-5 sm:p-6 bg-slate-50/50 dark:bg-slate-900/50 hover:bg-slate-50 dark:hover:bg-slate-850 transition-colors">
          <h3 class="text-base sm:text-lg font-bold text-slate-900 dark:text-slate-100 flex items-center gap-2.5">
            <span class="text-[#26b0a1] font-extrabold text-lg">Q.</span>
            {t.faq.q1}
          </h3>
          <p class="text-xs sm:text-sm text-slate-600 dark:text-slate-300 mt-2.5 pl-6 leading-relaxed">
            {t.faq.a1}
          </p>
        </div>

        <!-- Question 2 -->
        <div class="rounded-2xl border border-slate-200 dark:border-slate-800 p-5 sm:p-6 bg-slate-50/50 dark:bg-slate-900/50 hover:bg-slate-50 dark:hover:bg-slate-850 transition-colors">
          <h3 class="text-base sm:text-lg font-bold text-slate-900 dark:text-slate-100 flex items-center gap-2.5">
            <span class="text-[#26b0a1] font-extrabold text-lg">Q.</span>
            {t.faq.q2}
          </h3>
          <p class="text-xs sm:text-sm text-slate-600 dark:text-slate-300 mt-2.5 pl-6 leading-relaxed">
            {t.faq.a2}
          </p>
        </div>

        <!-- Question 3 -->
        <div class="rounded-2xl border border-slate-200 dark:border-slate-800 p-5 sm:p-6 bg-slate-50/50 dark:bg-slate-900/50 hover:bg-slate-50 dark:hover:bg-slate-850 transition-colors">
          <h3 class="text-base sm:text-lg font-bold text-slate-900 dark:text-slate-100 flex items-center gap-2.5">
            <span class="text-[#26b0a1] font-extrabold text-lg">Q.</span>
            {t.faq.q3}
          </h3>
          <p class="text-xs sm:text-sm text-slate-600 dark:text-slate-300 mt-2.5 pl-6 leading-relaxed">
            {t.faq.a3}
          </p>
        </div>

        <!-- Question 4 -->
        <div class="rounded-2xl border border-slate-200 dark:border-slate-800 p-5 sm:p-6 bg-slate-50/50 dark:bg-slate-900/50 hover:bg-slate-50 dark:hover:bg-slate-850 transition-colors">
          <h3 class="text-base sm:text-lg font-bold text-slate-900 dark:text-slate-100 flex items-center gap-2.5">
            <span class="text-[#26b0a1] font-extrabold text-lg">Q.</span>
            {t.faq.q4}
          </h3>
          <p class="text-xs sm:text-sm text-slate-600 dark:text-slate-300 mt-2.5 pl-6 leading-relaxed">
            {t.faq.a4}
          </p>
        </div>
      </div>
    </div>
  </section>
</div>
